rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /analyses/{analysisId} {
      // Allow read if the document is public, OR if the user is the owner
      allow read: if resource.data.isPublic == true || (request.auth != null && resource.data.uid == request.auth.uid);
      
      // Allow create only if logged in and setting themselves as the owner
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      
      // Allow update and delete only for the owner
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Khóa hoàn toàn collection này đối với client
    match /global_sentence_cache/{document=**} {
      allow read, write: if false; 
    }

    match /feedbacks/{feedbackId} {
      // Anyone (including unauthenticated users) can submit feedback
      allow create: if true;
      // Only admins read feedbacks — block all client reads
      allow read, update, delete: if false;
    }
  }
}
